# Rendered by openbench.envs.builder — one image per task, pinned at the base
# commit of {{ repo }} (python ecosystem).
FROM {{ base_image }}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Contamination control: clone and truncate in ONE layer, so no layer of the
# published image ever holds post-base history. The refs left are `main`
# pinned at the base commit plus tags that are ancestors of it; every commit
# not reachable from main (the gold fix, its tests, all later upstream
# history) is pruned from the object store, and the remote is dropped so
# nothing can be re-fetched. Pre-base history stays: git log/blame are
# legitimate agent tools. Ancestor tags stay because setuptools_scm derives
# the package's own version from the nearest reachable tag — with no tags,
# repos like pytest self-install as 0.1.dev* and their minversion checks
# abort the whole test suite at grading time. validate_task fetches the merge
# commit at validation time for its merged-passes leg instead.
RUN git clone https://github.com/{{ repo }} /repo \
    && cd /repo \
    && git checkout --quiet {{ base_commit }} \
    && git checkout -B main \
    && git remote remove origin \
    && git tag --merged main | sed 's|^|refs/tags/|' > /tmp/keeptags \
    && git for-each-ref --format='%(refname)' \
        | grep -v '^refs/heads/main$' \
        | grep -v -x -F -f /tmp/keeptags \
        | xargs -r -n 1 git update-ref -d \
    && rm -f /tmp/keeptags \
    && git reflog expire --expire=now --all \
    && git gc --prune=now \
    && rm -f .git/FETCH_HEAD
WORKDIR /repo

RUN python -m pip install --upgrade pip

# Build backends + scientific build deps, installed BEFORE the package so the
# editable install below can run with --no-build-isolation and resolve build
# tools (meson/ninja) to PERSISTENT site-packages paths. Required for
# meson-python *editable* installs (matplotlib, scikit-learn) whose loaders
# rebuild on import: under pip build isolation the loader records an ephemeral
# /tmp/pip-build-env-*/bin/ninja that is gone by test time (ENOENT at collect);
# --no-build-isolation records the stable path instead. Harmless for the
# pure-Python repos (their build deps are already in this set).
RUN pip install setuptools wheel hatchling hatch-vcs hatch-fancy-pypi-readme \
    flit-core poetry-core pdm-backend setuptools-scm \
    meson meson-python ninja Cython numpy scipy pybind11

# Install the package exactly as grading reinstalls it offline
# (--no-build-isolation, build deps already present above), so the editable
# build is consistent from base image through grade time. pytest only if the
# repo didn't already pin its own (never plugins like xdist: a modern plugin
# poisons collection when the repo under test is itself an old pytest).
RUN {{ offline_install_cmd }} \
    && pip install pytest

# Claude Code CLI for the claude-code agent runner (headless, stream-json).
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code

# Test dependencies: repos declare them in PEP 735 dependency groups or a
# `[project.optional-dependencies]` extra; names vary widely, so try the common
# ones best-effort (each independent — a repo may need several, e.g. xarray
# needs `io` for h5py). Failures are tolerated; the validation gate is the
# arbiter of whether the env is actually sufficient.
RUN for g in dev test tests testing; do pip install --group "$g" || true; done; \
    for e in dev test tests testing io complete all extra; do \
        pip install -e ".[$e]" || true; done; \
    true

# Task-specific environment fixes (task.json env_setup_cmds) — last, so they
# override anything the generic best-effort installs above pulled in.
{% for cmd in env_setup_cmds %}
RUN {{ cmd }}
{% endfor %}

# --system so root (validation/grading execs) and agent both see it.
RUN git config --system user.email bench@openbench \
    && git config --system user.name openbench \
    && git config --system --add safe.directory /repo

RUN useradd -m agent && chown -R agent:agent /repo
WORKDIR /repo
