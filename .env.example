# Copy to .env and fill in. The harness reads keys from the environment;
# they are never written into the repo, task images, or sandbox containers.
# (mini-swe calls the LLM API from the host; the agent container stays offline.)

# GitHub — for mining PRs (read-only). Falls back to `gh auth token` if unset.
GITHUB_TOKEN=

# Anthropic — for the claude-code runner (Anthropic models only).
ANTHROPIC_API_KEY=

# DeepSeek official API — serves only V4-flash / V4-pro.
DEEPSEEK_API_KEY=

# OpenAI — for gpt-* models (gpt-4.1, gpt-5.5) via the Responses API.
OPENAI_API_KEY=

# OpenRouter — for everything else (DeepSeek V3, Qwen, Llama, GLM, ...).
# model ids take the form openrouter/<provider>/<model>.
OPENROUTER_API_KEY=
