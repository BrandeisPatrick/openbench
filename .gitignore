.mypy_cache/

# Environments & secrets
.venv/
.env
.env.local

# Generated data — all reproducible from the pipeline, never committed:
#   datasets/ : mined PRs, constructed tasks (incl. gold patches → contamination
#               risk if public), the GitHub cache, the DuckDB warehouse.
#   runs/     : per-run transcripts, grades, metrics.
# Anchored to repo root (leading /) so they do NOT also match examples/runs/,
# which ships a curated, committed subset for the zero-credential demo.
/datasets/
/runs/

# Editor / tooling state
.claude/
.DS_Store

# Demo outputs (regenerated by `openbench demo`); input traces in examples/runs/ ARE committed
examples/report.md
examples/figures/
examples/runs/figures/
